{
  "name": "nuxt-custom-fetch",
  "type": "module",
  "version": "4.4.0",
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xjccc/nuxt-custom-fetch.git"
  },
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "echo:husky": "echo 'npx nano-staged' > .husky/pre-commit && echo 'npx --no-install commitlint --edit \"$1\"' > .husky/commit-msg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "commit": "git-cz",
    "prerelease": "changelogen --prerelease && pnpm prepack && npm publish --tag alpha",
    "release": "changelogen --release && pnpm prepack && npm publish && git push --follow-tags"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "peerDependencies": {
    "nuxt": ">=4.5.2",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@vue/shared": "^3.5.42",
    "ohash": "^2.0.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/kit": "4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "4.5.2",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.11",
    "changelogen": "^0.6.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "nitropack": "^2.13.4",
    "nuxt": "4.5.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "husky": {
    "hooks": {
      "pre-commit": "nano-staged"
    }
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
